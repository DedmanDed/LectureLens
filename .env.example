# Groq-hosted generation. Create a key at https://console.groq.com/keys
# Keep the real key in your shell or deployment secret manager, never in frontend code or Git.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=groq
# Optional: let Groq improve planner task wording; dates, task counts and minutes remain rules-based.
PLAN_WITH_GROQ=false

# Optional local fallback. Install Ollama and pull qwen2.5:3b first.
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5:3b
PORT=8000
